+/** Validate whether a URL uses http or https scheme. */
+function isAllowedHttpLink(url: unknown): url is string {
+  if (typeof url !== 'string' || url.length === 0) return false
+  try {
+    const parsed = new URL(url)
+    return parsed.protocol === 'http:' || parsed.protocol === 'https:'
+  } catch {
+    return false
+  }
+}
+
+/**
+ * Present a popup menu with zoomFactor coordinate scaling when anchor coordinates are provided,
+ * or at current cursor position when omitted.
+ */
+function popupScaledMenu(
+  menu: Menu,
+  window: BrowserWindow,
+  x?: number,
+  y?: number,
+  callback?: () => void,
+): void {
+  if (typeof x === 'number' && typeof y === 'number') {
+    const zoom = window.webContents.getZoomFactor()
+    menu.popup({
+      window,
+      x: Math.round(x * zoom),
+      y: Math.round(y * zoom),
+      ...(callback === undefined ? {} : { callback }),
+    })
+  } else {
+    menu.popup({
+      window,
+      ...(callback === undefined ? {} : { callback }),
+    })
+  }
+}
