+  SessionMenuItemProps, SessionTrashConfirmInjected, SessionTrashConfirmProps, SessionTrashConfirmRequest,
+  TrashSessionInjected,
+} from '../contract/slots.ts'
+import browserCss from '../rows/WorkspaceBrowser.module.css'
+
+/**
+ * Menu row (order 500): move to trash (Danger style).
+ * @param props - owner share, the trash share, and the menu open state.
+ * @returns the row.
+ */
+export function TrashSessionMenuItem({
+  sessionId, useMenuOpenState, trashSession, t,
+}: SessionMenuItemProps<TrashSessionInjected>) {
+  const [, setMenuOpen] = useMenuOpenState()
+  return (
+    <MenuItemButton
+      danger
+      separatorBefore
+      icon={<IconTrashOutlineRegular size={14} />}
+      onSelect={() => {
+        setMenuOpen(false)
+        trashSession(sessionId)
+      }}
+    >
+      {t('menu.trashSession')}
+    </MenuItemButton>
+  )
+}
+
+/**
+ * The `shell.overlay` entry: nothing while no confirmation is pending,
+ * otherwise one dialog per request (keyed by the Session). Confirming asks
+ * the Host to stop the listed work and move to trash; cancelling leaves the
+ * Session running and visible.
+ * @param props - the request hook, its settlement, the stop-and-trash hop, and the locale seat.
+ * @returns the open dialog, or null.
+ */
+export function SessionTrashConfirmDialog({
+  useTrashRequest, settleSessionTrash, stopAndTrashSession, t,
+}: SessionTrashConfirmProps) {
+  const request = useTrashRequest(pending => pending)
+  if (request === null) return null
+  return (
+    <TrashConfirmForm
+      key={request.sessionId}
+      request={request}
+      stopAndTrashSession={stopAndTrashSession}
+      onSettle={settleSessionTrash}
+      t={t}
+    />
+  )
+}
+
+/** One request's dialog: in-flight and error state die with it. */
+function TrashConfirmForm({ request, stopAndTrashSession, onSettle, t }: {
+  request: SessionTrashConfirmRequest
+  stopAndTrashSession: SessionTrashConfirmInjected['stopAndTrashSession']
+  onSettle: () => void
+  t: SessionTrashConfirmProps['t']
+}) {
+  const [trashing, setTrashing] = useState(false)
+  const [error, setError] = useState<string | null>(null)
+  const close = () => {
+    if (trashing) return
+    onSettle()
+  }
+  const confirm = () => {
+    setTrashing(true)
+    setError(null)
+    stopAndTrashSession(request.sessionId).then(() => {
+      setTrashing(false)
+      onSettle()
+    }).catch((reason: unknown) => {
+      setTrashing(false)
+      setError(reason instanceof Error ? reason.message : String(reason))
+    })
+  }
+  return (
+    <Modal
+      open
+      onClose={close}
+      closeLabel={t('close')}
+      title={t('trash.confirm.title')}
+      description={t('trash.confirm.desc', { title: request.displayTitle })}
+      footer={(
+        <>
+          <Button variant="outline" disabled={trashing} onClick={close}>{t('cancel')}</Button>
+          <Button
+            variant="outline"
+            className={browserCss.deleteAction}
+            disabled={trashing}
+            onClick={confirm}
+          >
+            {t('trash.confirm.action')}
+          </Button>
+        </>
+      )}
+    >
+      <ActivityList activity={request.activity} t={t} />
+      {trashing && <div className={browserCss.deleteStatus} role="status">{t('trash.confirm.pending')}</div>}
+      {error !== null && <div className={browserCss.renameError} role="alert">{error}</div>}
+    </Modal>
+  )
+}
+
