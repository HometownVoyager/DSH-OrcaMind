+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry from '@deepseek-ai/dsh-agent'
+import SessionStore, { SessionId } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-workspace'
+import { describe, expect, it, vi } from 'vitest'
+import { createSessionTestController } from './test-remote.ts'
+
+describe('Session Controller Remote Events', () => {
+  it('emits api-session/removed when workspace/session-delete is emitted', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    const sessionId = SessionId('deleted-session')
+    createSessionTestController(ctx, {
+      defaultModelSelection: () => ({ provider: 'fixture', model: 'fixture-model' }),
+      cwd: '/tmp',
+    })
+    const removed = vi.fn()
+    ctx.on('api-session/removed', removed)
+
+    await ctx.parallel('workspace/session-delete', { sessionId })
+    expect(removed).toHaveBeenCalledWith(sessionId)
+    await ctx.fiber.dispose()
+  })
+
+  it('cancels and disposes active agent when workspace/session-delete is emitted', async () => {
+    const ctx = new Context()
+    await ctx.plugin(SessionStore)
+    await ctx.plugin(AgentRegistry)
+    const sessionId = SessionId('active-session')
+    createSessionTestController(ctx, {
+      defaultModelSelection: () => ({ provider: 'fixture', model: 'fixture-model' }),
+      cwd: '/tmp',
+    })
+    const agentCancel = vi.fn()
+    const scopeDispose = vi.fn().mockResolvedValue(undefined)
+    const mockAgent = {
+      id: sessionId,
+      cancel: agentCancel,
+      whenIdle: () => Promise.resolve(),
+      scope: { dispose: scopeDispose },
+      ctx: { scope: { dispose: scopeDispose } },
+    }
+    vi.spyOn(ctx.agents, 'get').mockImplementation(id => (id === sessionId ? (mockAgent as never) : undefined))
+    const removed = vi.fn()
+    ctx.on('api-session/removed', removed)
+
+    await ctx.parallel('workspace/session-delete', { sessionId })
+    expect(agentCancel).toHaveBeenCalledWith({ kind: 'disposed' })
+    expect(scopeDispose).toHaveBeenCalled()
+    expect(removed).toHaveBeenCalledWith(sessionId)
+    await ctx.fiber.dispose()
+  })
+})
