+/**
+ * Physical session cleanup and OS recycle bin integration.
+ * @module @deepseek-ai/dsh-workspace/src/session-trash
+ */
+
+import { execFile } from 'node:child_process'
+import { rm, stat } from 'node:fs/promises'
+import { join } from 'node:path'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+
+/**
+ * Encode an arbitrary session id into a filesystem-safe single path segment.
+ * @param raw - The session id to encode.
+ * @returns Escaped path segment.
+ */
+export function encodeSegment(raw: string): string {
+  if (raw.length === 0) throw new Error('cannot encode an empty path segment')
+  if (raw === '.') return '~002E'
+  if (raw === '..') return '~002E~002E'
+  return raw.replace(/[^A-Za-z0-9._-]/g, ch => `~${ch.charCodeAt(0).toString(16).toUpperCase().padStart(4, '0')}`)
+}
+
+/**
+ * Build the readable directory key for a project path.
+ * @param cwd - The session's project directory.
+ * @returns A single filesystem-safe project directory name.
+ */
+export function projectKey(cwd: string): string {
+  if (cwd.length === 0) throw new Error('cannot encode an empty project path')
+  const readable = cwd
+    .replace(/[/\\:]+/g, '-')
+    .replace(/[^A-Za-z0-9._-]/g, ch => `~${ch.charCodeAt(0).toString(16).toUpperCase().padStart(4, '0')}`)
+  const slug = readable.replace(/^-+/, '') || 'root'
+  return `--${slug.slice(0, 251)}--`
+}
+
+/**
+ * Resolve the on-disk directory owned by one session.
+ * @param root - The session storage root directory.
+ * @param cwd - The session's project directory (cwd).
+ * @param id - The session id.
+ * @returns The absolute or relative session directory path.
+ */
+export function resolveSessionDir(root: string, cwd: string | undefined, id: SessionId | string): string {
+  const project = cwd === undefined ? '_no-cwd' : projectKey(cwd)
+  return join(root, project, encodeSegment(String(id)))
+}
+
+/**
+ * Move a target file or directory to the OS Recycle Bin / Trash.
+ * Supports:
+ * 1. Windows: PowerShell Microsoft.VisualBasic.FileIO.FileSystem (SendToRecycleBin)
+ * 2. macOS: Finder AppleScript / trash CLI
+ * 3. Linux: gio trash
+ * 4. Fallback: fs.rm
+ * @param targetPath - Path to remove or trash.
+ * @returns Whether the path was removed or trashed (false if it did not exist).
+ */
+export async function safelyTrashOrRemove(targetPath: string): Promise<boolean> {
+  try {
+    await stat(targetPath)
+  } catch (error) {
+    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {
+      return false
+    }
+  }
+
+  // 1. Windows: PowerShell SendToRecycleBin
+  if (process.platform === 'win32') {
+    try {
+      const escaped = targetPath.replace(/'/g, "''")
+      const psCommand = `Add-Type -AssemblyName Microsoft.VisualBasic; if (Test-Path -LiteralPath '${escaped}' -PathType Container) { [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteDirectory('${escaped}', 'OnlyErrorDialogs', 'SendToRecycleBin') } elseif (Test-Path -LiteralPath '${escaped}') { [Microsoft.VisualBasic.FileIO.FileSystem]::DeleteFile('${escaped}', 'OnlyErrorDialogs', 'SendToRecycleBin') }`
+      await new Promise<void>((resolve, reject) => {
+        execFile('powershell.exe', ['-NoProfile', '-NonInteractive', '-Command', psCommand], (err) => {
+          if (err) reject(new Error(err.message))
+          else resolve()
+        })
+      })
+      return true
+    } catch {
+      // Fallback below
+    }
+  }
+
+  // 2. macOS: osascript Finder delete
+  if (process.platform === 'darwin') {
+    try {
+      const escaped = targetPath.replace(/["\\]/g, '\\$&')
+      await new Promise<void>((resolve, reject) => {
+        execFile('osascript', ['-e', `tell application "Finder" to delete POSIX file "${escaped}"`], (err) => {
+          if (err) reject(new Error(err.message))
+          else resolve()
+        })
+      })
+      return true
+    } catch {
+      // Fallback below
+    }
+  }
+
+  // 3. Linux: gio trash
+  if (process.platform === 'linux') {
+    try {
+      await new Promise<void>((resolve, reject) => {
+        execFile('gio', ['trash', targetPath], (err) => {
+          if (err) reject(new Error(err.message))
+          else resolve()
+        })
+      })
+      return true
+    } catch {
+      // Fallback below
+    }
+  }
+
+  // 4. Ultimate fallback: fs.rm
+  try {
+    await rm(targetPath, { recursive: true, force: true })
+    return true
+  } catch (error) {
+    if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {
+      return false
+    }
+    throw error
+  }
+}
