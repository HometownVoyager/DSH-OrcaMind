+/**
+ * Shared active-work summary formatter and activity list for session confirmation dialogs.
+ * @module @deepseek-ai/dsh-client-ui-workspace/src/client/session-actions/activity-line
+ */
+
+import { createElement, type ReactNode } from 'react'
+import type { SessionActivity } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import type { SessionArchiveConfirmProps } from '../contract/slots.ts'
+import browserCss from '../rows/WorkspaceBrowser.module.css'
+
+/**
+ * One family's line: its count and the items' labels (ids when a family
+ * carries no label). A family this dictionary does not know — a provider
+ * merged into the kind map — falls through to the generic line.
+ * @param entry - Session activity details reported by the host.
+ * @param t - Localized workspace dictionary function.
+ * @returns Human-readable activity line.
+ */
+export function activityLine(entry: SessionActivity, t: SessionArchiveConfirmProps['t']): string {
+  const items = entry.items ?? []
+  const n = items.length
+  const names = items.map(item => item.label ?? item.id).join(t('archive.confirm.listSeparator'))
+  const plural = n === 1 ? 'one' : 'other'
+  switch (entry.kind) {
+    case 'turn': return t('archive.confirm.turn')
+    case 'subagent': return t(`archive.confirm.subagents.${plural}`, { n, names })
+    case 'job': return t(`archive.confirm.jobs.${plural}`, { n, names })
+    case 'schedule': return t(`archive.confirm.schedules.${plural}`, { n, names })
+    default: return t(`archive.confirm.other.${plural}`, { kind: entry.kind, n })
+  }
+}
+
+/**
+ * Render the list of active tasks/jobs/subagents blocking a session archive or trash operation.
+ * @param props - Activity list items and localization helper.
+ * @returns An unstyled or styled list of activities.
+ */
+export function ActivityList({
+  activity,
+  t,
+}: {
+  activity: readonly SessionActivity[]
+  t: SessionArchiveConfirmProps['t']
+}): ReactNode {
+  return createElement(
+    'ul',
+    { className: browserCss.archiveActivity, 'aria-label': t('archive.confirm.activity') },
+    activity.map((entry, index) => createElement('li', { key: `${entry.kind}-${String(index)}` }, activityLine(entry, t))),
+  )
+}
