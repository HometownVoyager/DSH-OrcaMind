+/**
+ * OpenCode's gateway refuses a request that carries no conversation identity
+ * (`400 MissingSessionID`) and routes the ones that do. pi-ai emits only its own
+ * session-affinity spellings (`session_id`, `x-client-request-id`,
+ * `x-session-affinity`, `x-session-id`), none of which OpenCode reads, and only
+ * on protocol paths whose catalog entries opt in — so a pi-ai route to OpenCode
+ * arrives without one. The adapter stamps the loop's session id itself:
+ * `x-opencode-session` is the documented header, and OpenCode Go also recognizes
+ * the Harness-native `x-deepseek-harness-session-id` the direct adapter sends.
+ * @param model - the resolved pi-ai model the request targets.
+ * @param sessionId - the loop's session identity; absent outside conversations.
+ * @returns the session headers for an OpenCode route, empty for any other route.
+ */
+function openCodeSessionHeaders(model: Model<Api>, sessionId: string | undefined): Record<string, string> {
+  if (sessionId === undefined) return {}
+  const openCode = model.provider === 'opencode' || model.provider === 'opencode-go'
+    || model.baseUrl.includes('opencode.ai')
+  return openCode
+    ? { 'x-opencode-session': sessionId, 'x-deepseek-harness-session-id': sessionId }
+    : {}
+}
